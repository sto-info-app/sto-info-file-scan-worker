#!/command/execlineb -P
# The updater. Depends on clamd, and waits until clamd answers, so that the
# notification it sends after an update has something to arrive at: s6 starts
# it as soon as clamd's process starts, before clamd is listening.
fdmove -c 2 1
foreground { /usr/local/bin/wait-for-clamd }
/usr/bin/freshclam --config-file=/etc/clamav/freshclam.conf --daemon --foreground
