{
  "name": "sto-info-file-scan-worker",
  "version": "0.1.0",
  "description": "Star Trek Online Information - File scan worker (type validation + AV scanning) using NestJS, BullMQ, TypeORM and Cloudflare R2.",
  "author": "Steve Roberts",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sto-info-app/sto-info-file-scan-worker.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "npm run clean && nest build",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./config/typeorm.datasource.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./config/typeorm.datasource.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./config/typeorm.datasource.ts",
    "prepare": "husky",
    "rehearse:scan": "bash scripts/scan-rehearsal/run-rehearsal.sh",
    "rehearse:migration": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1792400000000-CreateFileScanAttempt.ts file-scan-attempt",
    "rehearse:migration:scan-usage": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1792400000000-CreateFileScanAttempt.ts,src/database/migrations/1794800000000-RecordScanUsage.ts scan-usage",
    "start": "cross-env TZ=UTC node dist/src/main",
    "start:debug": "cross-env TZ=UTC nest start --debug --watch",
    "start:dev": "cross-env TZ=UTC nest start --watch",
    "start:dist": "npm run build && npm run migration:run && npm run start:prod",
    "start:prod": "cross-env TZ=UTC node dist/src/main",
    "start:render": "npm run migration:run && npm run start:prod",
    "start:watch": "npm run start:dev",
    "summary:ci": "node scripts/generate-ci-summary.mjs",
    "test": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "cross-env TZ=UTC NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8192 --disable-warning=ExperimentalWarning\" jest --config jest.config.mjs --runInBand --coverage --coverageDirectory=reports/coverage",
    "test:debug": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:mutation": "stryker run --reporters clear-text --reporters html --reporters progress",
    "test:mutation:dry": "stryker run --reporters clear-text --reporters html --reporters progress --dryRunOnly",
    "test:mutation:incremental": "node ./scripts/run-incremental-mutation.mjs",
    "test:watch": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typeorm": "ts-node -r tsconfig-paths/register ./config/run-typeorm.ts",
    "verify": "npm audit --audit-level=high --omit=dev && npm run lint && npm run format:check && npm run test:cov && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.2",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.2",
    "@nestjs/platform-express": "^12.0.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ]
  },
  "jest-junit": {
    "suiteName": "sto-info-file-scan-worker",
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml",
    "addFileAttribute": "true",
    "usePathForSuiteName": "true"
  }
}
