{
  "name": "sto-info-file-scan-worker",
  "version": "0.1.0",
  "description": "Star Trek Online Information - File scan worker (type validation + AV scanning) using NestJS, BullMQ, TypeORM and Cloudflare R2.",
  "author": "Steve Roberts",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steverobertsuk/sto-info-file-scan-worker.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "npm run clean && nest build",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./config/typeorm.datasource.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./config/typeorm.datasource.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d ./config/typeorm.datasource.ts",
    "rehearse:migration": "bash scripts/migration-rehearsal/run-rehearsal.sh src/database/migrations/1792400000000-CreateFileScanAttempt.ts file-scan-attempt",
    "start": "cross-env TZ=UTC node dist/src/main",
    "start:debug": "cross-env TZ=UTC nest start --debug --watch",
    "start:dev": "cross-env TZ=UTC nest start --watch",
    "start:dist": "npm run build && npm run migration:run && npm run start:prod",
    "start:prod": "cross-env TZ=UTC node dist/src/main",
    "start:render": "npm run migration:run && npm run start:prod",
    "start:watch": "npm run start:dev",
    "test": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "cross-env TZ=UTC NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.config.mjs --runInBand --coverage --coverageDirectory=reports/coverage --coverageReporters=lcov --coverageReporters=cobertura --coverageReporters=text-summary",
    "test:debug": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:mutation": "stryker run --reporters clear-text --reporters html --reporters progress",
    "test:mutation:dry": "stryker run --reporters clear-text --reporters html --reporters progress --dryRunOnly",
    "test:watch": "cross-env TZ=UTC NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typeorm": "ts-node -r tsconfig-paths/register ./config/run-typeorm.ts",
    "verify": "npm run lint && npm run format:check && npm run test:cov && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-secrets-manager": "^3.1130.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.23.0",
    "@eslint/object-schema": "^3.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "glob": "^13.0.0",
    "globals": "^17.1.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "diff": "^8.0.3",
    "form-data": "4.0.6",
    "handlebars": "4.7.9",
    "js-yaml": "4.2.0",
    "lodash": "^4.17.24",
    "multer": "2.2.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "qs": "6.15.2",
    "serialize-javascript": "7.0.4",
    "uuid": "14.0.1"
  }
}
