# Application Environment
NODE_ENV=local # Options: local, dev, staging, prod
LOG_LEVEL=log # error,warn,log,debug,verbose (optionally comma-separated)

# Application
APP_PORT=3000
APP_TITLE="Star Trek Online Info File Scan Worker"

# Database (Postgres)
#
# The same database as the backend, in a schema of this repository's own.
# DB_SCHEMA must be sto_info_worker: the migrations name the schema in their
# SQL, and the worker refuses to start if the two disagree. ADR-0006.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sto_info_app_local
DB_SCHEMA=sto_info_worker
DB_USERNAME=sto_info_worker
DB_SSL_REJECT_UNAUTHORIZED=false

# TypeORM
#
# There is no TYPEORM_SYNCHRONIZE. Synchronise against a database shared with
# another application will drop that application's columns to make the schema
# match these entities, so the worker refuses to start when it is set.
TYPEORM_LOGGING=false
TYPEORM_ENTITIES='src/**/*.entity.{js,ts}'
TYPEORM_MIGRATIONS='src/database/migrations/*.{js,ts}'

# Redis (BullMQ)
#
# Two queues, and the worker's relationship to them is not symmetrical: it
# consumes file-scan and only ever writes to file-scan-verdict. The names are
# fixed by the contract and are not configurable, because a queue name that
# differed between the two repositories would look like an idle worker.
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull:sto-info:

# The contract version this process speaks. It must be one the build
# supports, or the worker refuses to start rather than half-understanding a
# message. ADR-0006 decision 3.
FILE_SCAN_SCHEMA_VERSION=1

# AWS (Secrets Manager)
#
# Holds dbPassword, cloudflareR2QuarantineReadKey and
# cloudflareR2QuarantineReadSecret. The R2 credentials are read-only and
# reach the quarantine bucket alone: the worker cannot write there, cannot
# delete there, and has no credential for the bucket the site delivers from.
AWS_ACCESS_KEY_ID='YOUR_AWS_ACCESS_KEY_ID'
AWS_SECRET_ACCESS_KEY='YOUR_AWS_SECRET_ACCESS_KEY'
AWS_REGION='YOUR_AWS_REGION'
AWS_SECRET_NAME='YOUR_AWS_SECRET_NAME'

# Cloudflare R2 (S3 compatible)
#
# One quarantine bucket for every environment, with the environment as the
# first segment of each key. ADR-0017.
CLOUDFLARE_R2_ENDPOINT='https://your-account-id.r2.cloudflarestorage.com'
CLOUDFLARE_R2_QUARANTINE_BUCKET_NAME='your-quarantine-bucket-name'

# Scanning
#
# SCAN_HEARTBEAT_MS and SCAN_TIMEOUT_MS must both be shorter than
# SCAN_LEASE_MS, or an attempt outlives the claim that owns it. The worker
# checks this at startup.
SCAN_CONCURRENCY=1
MAX_FILE_BYTES=10485760
SCAN_TIMEOUT_MS=120000
SCAN_LEASE_MS=300000
SCAN_HEARTBEAT_MS=30000
SCAN_MAX_ATTEMPTS=3

# ClamAV
#
# clamd, spoken to over its socket with INSTREAM. Nothing is written to disk.
# A signature database older than the maximum age is never allowed to produce
# a clean verdict, and the readiness probe fails while it is. ADR-0005.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_MAX_DEFINITION_AGE_HOURS=48

# Optional diagnostics
STARTUP_DIAGNOSTICS=false
