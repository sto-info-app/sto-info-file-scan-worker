# Application Environment
NODE_ENV=local # Options: local, dev, staging, prod
LOG_LEVEL=log # error,warn,log,debug,verbose (optionally comma-separated)

# Application
APP_PORT=3000
APP_TITLE="Star Trek Online Info File Scan Worker"

# Database (Postgres)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sto_info_worker_example_db
DB_SCHEMA=sto_info_worker_example_schema
DB_USERNAME=postgres
DB_SSL_REJECT_UNAUTHORIZED=false

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull:sto-info:
FILE_SCAN_QUEUE=file-scan
FLEET_IMPORT_QUEUE=fleet-import
ENQUEUE_NEXT_ON_PASSED=true

# TypeORM
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
TYPEORM_ENTITIES='src/**/*.entity.{js,ts}'
TYPEORM_MIGRATIONS='src/database/migrations/*.{js,ts}'

# AWS (Secrets Manager)
# NOTE: Secrets (dbPassword, Cloudflare R2 keys, Cloudmersive key, etc.) are pulled from the secret referenced by AWS_SECRET_NAME.
AWS_ACCESS_KEY_ID='YOUR_AWS_ACCESS_KEY_ID'
AWS_SECRET_ACCESS_KEY='YOUR_AWS_SECRET_ACCESS_KEY'
AWS_REGION='YOUR_AWS_REGION'
AWS_SECRET_NAME='YOUR_AWS_SECRET_NAME'

# Cloudflare R2 (S3 compatible)
CLOUDFLARE_R2_ENDPOINT='https://your-account-id.r2.cloudflarestorage.com'
CLOUDFLARE_R2_BUCKET_NAME='your-bucket-name'

# Limits
MAX_FILE_BYTES=10485760
SCAN_TIMEOUT_MS=120000
VALIDATION_READ_BYTES=262144

# ClamAV
CLAMAV_MODE=clamscan
CLAMAV_PATH=clamscan

# Trust proxy (if applicable, though usually for APIs)
TRUST_PROXY_HOPS=1

# Optional diagnostics
STARTUP_DIAGNOSTICS=false
